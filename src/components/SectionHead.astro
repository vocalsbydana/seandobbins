---
import T from './T.astro';
/** Section header: number + title on a hairline. Pass copy keys (numKey/titleKey/blurbKey) so the text is editable, or literal strings. */
interface Props { num?: string; title?: string; blurb?: string; numKey?: string; titleKey?: string; blurbKey?: string; as?: 'h1' | 'h2' | 'h3'; id?: string }
const { num, title, blurb, numKey, titleKey, blurbKey, as: Tag = 'h2', id } = Astro.props;
---
<div class="section-head" id={id} data-reveal>
  <div class="section-head__title">
    {numKey ? <T k={numKey} class="section-head__num" aria-hidden="true" /> : num && <span class="section-head__num" aria-hidden="true">{num}</span>}
    {titleKey ? <T k={titleKey} as={Tag} class="display-3" /> : <Tag class="display-3">{title}</Tag>}
  </div>
  {blurbKey ? <T k={blurbKey} as="p" /> : blurb && <p>{blurb}</p>}
  <slot />
</div>
