---
/** The ride-and-stick mark. Ring takes the type color; the stick is always brass. `spin` animates the stick once on load. */
interface Props { size?: number; color?: string; class?: string; spin?: boolean; title?: string }
const { size = 32, color = 'currentColor', class: cls = '', spin = false, title } = Astro.props;
const stroke = Math.max(2, size * 0.09);
const stick = Math.max(2, size * 0.075);
const dot = Math.max(2.5, size * 0.09);
---
<span class:list={['mark', cls, { 'mark--spin': spin }]} style={`--mark-size:${size}px;--mark-color:${color};--mark-stroke:${stroke}px;--mark-stick:${stick}px;--mark-dot:${dot}px`} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <span class="mark__ring"></span>
  <span class="mark__dot"></span>
  <span class="mark__stick"></span>
</span>
<style>
  .mark { position: relative; display: inline-block; width: var(--mark-size); height: var(--mark-size); flex: none; }
  .mark__ring { position: absolute; inset: 0; border-radius: 50%; border: var(--mark-stroke) solid var(--mark-color); }
  .mark__dot { position: absolute; top: 50%; left: 50%; width: var(--mark-dot); height: var(--mark-dot); transform: translate(-50%, -50%); border-radius: 50%; background: var(--mark-color); }
  .mark__stick { position: absolute; top: 50%; left: calc(var(--mark-size) * -0.16); right: calc(var(--mark-size) * -0.16); height: var(--mark-stick); margin-top: calc(var(--mark-stick) / -2); background: var(--brass); border-radius: 3px; transform: rotate(-32deg); transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .mark--spin .mark__stick { animation: stick-in 1.1s var(--ease-out) both; }
    .mark--spin .mark__ring { animation: ring-in .9s var(--ease-out) both; }
  }
  @keyframes stick-in { from { transform: rotate(148deg) scaleX(.2); opacity: 0; } to { transform: rotate(-32deg) scaleX(1); opacity: 1; } }
  @keyframes ring-in { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>
