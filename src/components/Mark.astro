---
/**
 * The ride-and-stick mark. Ring takes the type color; the drumstick is always brass: a tapered shaft ending in a bead
 * (Brand Guidelines v1.1). `spin` plays the entrance once on load: the ring fades up, the stick swings in, lifts from
 * its butt end and strikes the ride, which shivers on impact. Hovering the mark (or a link that wraps it) replays the
 * strike. All of it is skipped when the visitor prefers reduced motion.
 */
interface Props { size?: number; color?: string; class?: string; spin?: boolean; title?: string }
const { size = 32, color = 'currentColor', class: cls = '', spin = false, title } = Astro.props;
const stroke = Math.max(2, size * 0.083);
const stick = Math.max(2, size * 0.06);
const dot = Math.max(2.5, size * 0.1);
---
<span class:list={['mark', cls, { 'mark--spin': spin }]} style={`--mark-size:${size}px;--mark-color:${color};--mark-stroke:${stroke}px;--mark-stick:${stick}px;--mark-dot:${dot}px`} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <span class="mark__ring"></span>
  <span class="mark__dot"></span>
  <span class="mark__stick"><span class="mark__swing"><span class="mark__shaft"></span><span class="mark__tip"></span></span></span>
</span>
<style>
  .mark { position: relative; display: inline-block; width: var(--mark-size); height: var(--mark-size); flex: none; }
  .mark__ring { position: absolute; inset: 0; border-radius: 50%; border: var(--mark-stroke) solid var(--mark-color); }
  .mark__dot { position: absolute; top: 50%; left: 50%; width: var(--mark-dot); height: var(--mark-dot); transform: translate(-50%, -50%); border-radius: 50%; background: var(--mark-color); }
  .mark__stick { position: absolute; top: 50%; left: calc(var(--mark-size) * -0.16); right: calc(var(--mark-size) * -0.16); height: var(--mark-stick); margin-top: calc(var(--mark-stick) / -2); transform: rotate(-32deg); transform-origin: center; }
  /* The swing pivots at the butt end of the stick, so a lift raises the tip off the ride and the strike brings it back. */
  .mark__swing { position: absolute; inset: 0; transform-origin: left center; }
  /* Shaft tapers toward the tip; the tip is a bead 1.6× the shaft thickness long. */
  .mark__shaft { position: absolute; left: 0; top: 0; right: calc(var(--mark-stick) * 1.6); height: 100%; background: var(--brass); border-radius: var(--mark-stick); clip-path: polygon(0 0, 84% 14%, 100% 26%, 100% 74%, 84% 86%, 0 100%); }
  .mark__tip { position: absolute; right: 0; top: 50%; width: calc(var(--mark-stick) * 1.6); height: calc(var(--mark-stick) * 1.143); transform: translateY(-50%); background: var(--brass); border-radius: 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .mark--spin .mark__stick { animation: stick-in 1.1s var(--ease-out) both; }
    .mark--spin .mark__swing { animation: strike .7s cubic-bezier(.2, .9, .3, 1) 1s both; }
    .mark--spin .mark__ring { animation: ring-in .9s var(--ease-out) both, ring-hit .55s ease-out 1.3s both; }
    .mark--spin .mark__dot { animation: bell-hit .4s ease-out 1.3s both; }
    /* Hover replays the strike: on the mark itself, or on a link/button that wraps it (the wordmark). The load
       animations stay in the list under the same names (so they are not restarted) and a second, identical set of
       keyframes is appended, which is what makes the browser play it again. */
    .mark:hover .mark__swing, :global(a:hover) > .mark .mark__swing, :global(button:hover) > .mark .mark__swing { animation: strike 0s linear both, strike-again .6s cubic-bezier(.2, .9, .3, 1) both; }
    .mark:hover .mark__ring, :global(a:hover) > .mark .mark__ring, :global(button:hover) > .mark .mark__ring { animation: ring-in 0s linear both, ring-hit 0s linear both, ring-hit-again .55s ease-out .25s both; }
    .mark:hover .mark__dot, :global(a:hover) > .mark .mark__dot, :global(button:hover) > .mark .mark__dot { animation: bell-hit 0s linear both, bell-hit-again .4s ease-out .25s both; }
  }
  @keyframes stick-in { from { transform: rotate(148deg) scaleX(.2); opacity: 0; } to { transform: rotate(-32deg) scaleX(1); opacity: 1; } }
  @keyframes ring-in { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  /* Lift (tip rises, pivoting at the butt), drop onto the ride with a little bounce, settle. */
  @keyframes strike { 0% { transform: rotate(0deg); } 40% { transform: rotate(-16deg); } 62% { transform: rotate(3deg); } 78% { transform: rotate(-1.5deg); } 100% { transform: rotate(0deg); } }
  @keyframes strike-again { 0% { transform: rotate(0deg); } 40% { transform: rotate(-16deg); } 62% { transform: rotate(3deg); } 78% { transform: rotate(-1.5deg); } 100% { transform: rotate(0deg); } }
  /* The ride shivers on impact: a quick swell and wobble that dies out. */
  @keyframes ring-hit { 0% { transform: scale(1) rotate(0deg); } 18% { transform: scale(1.08) rotate(2.5deg); } 40% { transform: scale(.97) rotate(-2deg); } 62% { transform: scale(1.025) rotate(1deg); } 82% { transform: scale(.995) rotate(-.5deg); } 100% { transform: scale(1) rotate(0deg); } }
  @keyframes ring-hit-again { 0% { transform: scale(1) rotate(0deg); } 18% { transform: scale(1.08) rotate(2.5deg); } 40% { transform: scale(.97) rotate(-2deg); } 62% { transform: scale(1.025) rotate(1deg); } 82% { transform: scale(.995) rotate(-.5deg); } 100% { transform: scale(1) rotate(0deg); } }
  @keyframes bell-hit { 0% { transform: translate(-50%, -50%) scale(1); } 30% { transform: translate(-50%, -50%) scale(1.5); } 100% { transform: translate(-50%, -50%) scale(1); } }
  @keyframes bell-hit-again { 0% { transform: translate(-50%, -50%) scale(1); } 30% { transform: translate(-50%, -50%) scale(1.5); } 100% { transform: translate(-50%, -50%) scale(1); } }
</style>
