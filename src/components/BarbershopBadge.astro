---
/** The Barbershop contained badge. Stripes only inside the ring. Use as a section marker, never in the header or near booking. */
interface Props { size?: number; class?: string }
const { size = 168, class: cls = '' } = Astro.props;
const stripe = Math.max(4, Math.round(size / 12));
const pad = Math.max(3, Math.round(size / 12));
---
<div class:list={['bs-badge', cls]} style={`--size:${size}px;--stripe:${stripe}px;--pad:${pad}px`} role="img" aria-label="Sean Dobbins' The Barbershop, IU Jacobs">
  <div class="bs-badge__inner">
    <div class="bs-badge__eyebrow">Sean Dobbins'</div>
    <div class="bs-badge__title">The<br />Barbershop</div>
    <div class="bs-badge__foot">IU Jacobs</div>
  </div>
</div>
<style>
  .bs-badge { width: var(--size); height: var(--size); flex: none; border-radius: 50%; padding: var(--pad); background: repeating-linear-gradient(135deg, var(--royal) 0 var(--stripe), var(--ivory) var(--stripe) calc(var(--stripe) * 2), var(--brass) calc(var(--stripe) * 2) calc(var(--stripe) * 3)); }
  .bs-badge__inner { width: 100%; height: 100%; border-radius: 50%; background: var(--ink); color: var(--ivory); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: calc(var(--size) * .012); }
  .bs-badge__eyebrow { font-size: calc(var(--size) * .054); letter-spacing: .26em; text-transform: uppercase; color: var(--brass); }
  .bs-badge__title { font-family: var(--font-display); font-size: calc(var(--size) * .18); line-height: .9; text-transform: uppercase; padding: calc(var(--size) * .012) 0; }
  .bs-badge__foot { font-size: calc(var(--size) * .048); letter-spacing: .14em; text-transform: uppercase; color: var(--ivory-70); }
  @media (prefers-reduced-motion: no-preference) { .bs-badge { animation: badge-in 1s var(--ease-out) both; } }
  @keyframes badge-in { from { transform: rotate(-18deg) scale(.9); opacity: 0; } }
</style>
