---
/**
 * World map of teaching engagements: country outlines on paper (src/data/world-map.json, generated by
 * scripts/build-map.mjs); each city with entries is a Royal pin. Cities that would overlap at world scale collapse
 * into one cluster pin: clicking it zooms in (a sharper layer with state lines appears, "Back to world" returns) and
 * the member pins show. Hover shows the city and count; clicking a city pin lists its work and filters the list
 * below. Cities come from the outreach entries; positions from src/data/places.json.
 */
import T from './T.astro';
import { copy } from '../lib/copy';
import places from '../data/places.json';
import map from '../data/world-map.json';
import { project, zoomTree, placeOf } from '../lib/geo.mjs';

interface Entry { id: string; data: { institution: string; city: string; country: string; year?: number; yearEnd?: number; ongoing: boolean; type: string; note?: string } }
const { entries, when } = Astro.props as { entries: Entry[]; when: (d: Entry['data']) => string };
const c = copy.outreach.map;

type Pin = { key: string; label: string; xy: [number, number]; items: Entry[] };
const pinsByKey = new Map<string, Pin>();
const missing: string[] = [];
for (const e of entries) {
  const ll = placeOf(places, e.data.city);
  if (!ll) { missing.push(e.data.city); continue; }
  const key = ll.join(','); const label = e.data.city.replace(/^Detroit Public Schools, /, '');
  const pin = pinsByKey.get(key) || { key, label, xy: project(ll[1], ll[0]) as [number, number], items: [] };
  if (label.length < pin.label.length) pin.label = label; // cities sharing a spot (Rochester / Rochester Hills) take the shorter name
  pin.items.push(e); pinsByKey.set(key, pin);
}
if (missing.length) console.warn('[map] no pin for city (add to src/data/places.json):', [...new Set(missing)].join('; '));
const pins = [...pinsByKey.values()];
// Zoom steps (nested where a cluster is still crowded) and the pre-generated fine dot layer that covers each, if any.
type Zoom = { id: string; parent: string; members: number[]; box: number[]; at: [number, number] };
const tree: Zoom[] = zoomTree(pins.map((p) => p.xy));
const inside = (xy: [number, number], b: number[], t = 0.5) => xy[0] >= b[0] - t && xy[0] <= b[0] + b[2] + t && xy[1] >= b[1] - t && xy[1] <= b[1] + b[3] + t;
const zooms = tree.map((z) => {
  const layer = map.zooms.filter((l) => z.members.every((k) => inside(pins[k].xy, l.box))).sort((a, b) => a.box[2] - b.box[2])[0];
  return { ...z, box: layer ? layer.box : z.box, d: layer ? { land: layer.land, lakes: layer.lakes, borders: layer.borders, states: layer.states } : null, count: z.members.reduce((n, k) => n + pins[k].items.length, 0) };
});
const homeOf = (k: number) => { let h = ''; for (const z of tree) if (z.members.includes(k)) h = z.id; return h; };
const total = pins.reduce((n, p) => n + p.items.length, 0);
const r = (n: number) => Math.round(n * 100) / 100;
---
<div class="omap" data-omap data-world={map.world.join(' ')} data-one={c.one} data-many={c.many}>
  <div class="omap__bar">
    <T k="outreach.map.hint" as="p" class="small muted omap__hint" />
    <button type="button" class="btn btn--secondary omap__back" data-back hidden><T k="outreach.map.back" /></button>
  </div>
  <div class="omap__stage">
    <svg class="omap__svg" viewBox={map.world.join(' ')} role="group" aria-label={c.aria}>
      <g data-world-land>
        <path class="omap__land" d={map.land} />
        <path class="omap__lakes" d={map.lakes} />
        <path class="omap__borders" d={map.borders} />
      </g>
      {zooms.map((z) => z.d && (
        <g class="is-off" data-fine={z.id} data-box={z.box.join(' ')}>
          <path class="omap__land" d={z.d.land} />
          <path class="omap__lakes" d={z.d.lakes} />
          <path class="omap__borders omap__borders--state" d={z.d.states} />
          <path class="omap__borders" d={z.d.borders} />
        </g>
      ))}
      {pins.map((p, i) => (
        <g class:list={['omap__pin', { 'is-off': !!homeOf(i) }]} data-pin={p.key} data-zoom={homeOf(i)} data-label={p.label} data-count={p.items.length} tabindex="0" role="button" aria-label={`${p.label}: ${p.items.length}`}>
          <circle class="omap__pulse" cx={r(p.xy[0])} cy={r(p.xy[1])} r="15" />
          <circle class="omap__hit" cx={r(p.xy[0])} cy={r(p.xy[1])} r="15" />
          <circle class="omap__dot" cx={r(p.xy[0])} cy={r(p.xy[1])} r="6" />
        </g>
      ))}
      {zooms.map((z) => (
        <g class:list={['omap__pin omap__pin--group', { 'is-off': !!z.parent }]} data-group={z.id} data-parent={z.parent} data-label={`${z.members.length} ${c.placesLabel}`} data-count={z.count} tabindex="0" role="button" aria-label={`${z.members.length} ${c.placesLabel}: ${z.count}`}>
          <circle class="omap__pulse" cx={r(z.at[0])} cy={r(z.at[1])} r="15" />
          <circle class="omap__hit" cx={r(z.at[0])} cy={r(z.at[1])} r="15" />
          <circle class="omap__dot" cx={r(z.at[0])} cy={r(z.at[1])} r="8.5" />
        </g>
      ))}
    </svg>
    <div class="omap__tip paper small" role="tooltip" hidden><b data-tip-name></b><span data-tip-count></span></div>
  </div>
  <div class="omap__panel paper" data-panel hidden>
    <div class="omap__panel-head">
      <strong class="omap__city" data-city></strong>
      <button type="button" class="link omap__all" data-all><T k="outreach.map.showAll" /></button>
    </div>
    {pins.map((p) => (
      <ol role="list" class="omap__list" data-list={p.key} hidden>
        {p.items.map((e) => <li><span class="omap__year">{when(e.data)}</span><span><strong>{e.data.institution}</strong>{e.data.note ? <span class="small muted"> · {e.data.note}</span> : ''}</span><span class="label omap__type">{e.data.type}</span></li>)}
      </ol>
    ))}
  </div>
  <p class="small muted omap__total">{total} {c.pinsLabel} · {pins.length} {c.placesLabel} · <T k="outreach.map.credit" /></p>
</div>

<style>
  .omap { margin-block: var(--s-4) var(--s-6); }
  .omap__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px var(--s-3); min-height: 44px; margin-bottom: var(--s-2); }
  .omap__hint { flex: 1 1 320px; margin: 0; }
  .omap__back { margin-left: auto; }
  .omap__stage { position: relative; background: var(--paper); border: var(--hairline); }
  .omap__svg { display: block; width: 100%; height: auto; touch-action: manipulation; }
  .omap__svg path { pointer-events: none; }
  .omap__land { fill: var(--ivory); stroke: var(--stage); stroke-opacity: .55; stroke-width: 1px; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .omap__lakes { fill: var(--paper); stroke: var(--stage); stroke-opacity: .35; stroke-width: 1px; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .omap__borders { fill: none; stroke: var(--stage); stroke-opacity: .45; stroke-width: 1px; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .omap__borders--state { stroke-opacity: .22; }
  .omap__svg .is-off { display: none; }
  .omap__back[hidden] { display: none; }
  .omap__pin { cursor: pointer; outline: none; }
  .omap__pin.is-off { display: none; }
  .omap__hit { fill: transparent; stroke: none; pointer-events: all; }
  .omap__dot { fill: var(--royal); stroke: var(--paper); stroke-width: 1.5px; vector-effect: non-scaling-stroke; pointer-events: none; transition: fill var(--dur-fast); }
  .omap__pin:hover .omap__dot, .omap__pin:focus-visible .omap__dot, .omap__pin.is-active .omap__dot { fill: var(--stage); }
  .omap__pin:focus-visible .omap__pulse { stroke: var(--royal); stroke-width: 2px; vector-effect: non-scaling-stroke; fill: none; animation: none; fill-opacity: 1; }
  .omap__pulse { fill: var(--royal); fill-opacity: .16; stroke: none; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) { .omap__pulse { animation: omap-pulse 2.8s ease-in-out infinite; } }
  @keyframes omap-pulse { 0% { fill-opacity: .28; } 50% { fill-opacity: .08; } 100% { fill-opacity: .28; } }
  .omap__tip { position: absolute; z-index: 3; transform: translate(-50%, calc(-100% - 14px)); padding: 6px 10px; white-space: nowrap; pointer-events: none; box-shadow: 0 8px 24px rgba(11, 11, 20, .18); }
  .omap__tip b { display: block; font-size: 14px; }
  .omap__panel { margin-top: var(--s-2); padding: clamp(16px, 2.5vw, 28px); }
  .omap__panel-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); margin-bottom: 8px; }
  .omap__city { font-family: var(--font-display); font-size: 28px; line-height: 1; text-transform: uppercase; }
  .omap__all { background: none; border: 0; border-bottom: 1.5px solid var(--brass); padding: 0 0 1px; font: inherit; font-weight: 600; color: var(--royal); cursor: pointer; white-space: nowrap; }
  .omap__list li { display: grid; grid-template-columns: 72px 1fr auto; gap: 12px; align-items: baseline; padding: 10px 0; border-top: var(--hairline); }
  .omap__list li:last-child { border-bottom: var(--hairline); }
  .omap__year { font-family: var(--font-display); font-size: 22px; color: var(--royal); line-height: 1; }
  .omap__type { font-size: 11px; }
  @media (max-width: 520px) { .omap__list li { grid-template-columns: 64px 1fr; } .omap__type { grid-column: 2; } }
  .omap__total { margin-top: 8px; }
</style>

<script>
  function bind() {
    const root = document.querySelector<HTMLElement>('[data-omap]:not([data-bound])');
    if (!root) return; root.dataset.bound = '1';
    const svg = root.querySelector<SVGSVGElement>('svg')!; const world = root.dataset.world!;
    const tip = root.querySelector<HTMLElement>('.omap__tip')!; const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const tipName = tip.querySelector<HTMLElement>('[data-tip-name]')!, tipCount = tip.querySelector<HTMLElement>('[data-tip-count]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!; const cityEl = panel.querySelector<HTMLElement>('[data-city]')!;
    const pins = Array.from(root.querySelectorAll<SVGGElement>('.omap__pin[data-pin]'));
    const groupPins = Array.from(root.querySelectorAll<SVGGElement>('.omap__pin[data-group]'));
    const fines = Array.from(root.querySelectorAll<SVGGElement>('[data-fine]'));
    const worldLand = Array.from(root.querySelectorAll<SVGGElement>('[data-world-land]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-row-city]'));
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let zoomed = '';

    const setView = (vb: string, animate = true) => {
      const from = svg.getAttribute('viewBox')!.split(' ').map(Number), to = vb.split(' ').map(Number);
      if (!animate || reduce()) { svg.setAttribute('viewBox', vb); scalePulses(to[2]); return; }
      const t0 = performance.now(), dur = 650;
      const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); const cur = from.map((f, i) => f + (to[i] - f) * e); svg.setAttribute('viewBox', cur.join(' ')); scalePulses(cur[2]); if (p < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    };
    // Pin sizes are set in viewBox units so that they come out at a fixed pixel size at any zoom and any screen width
    // (r = px × viewBox width ÷ rendered width). Plain circles: no stroke tricks, so every browser draws them.
    const PX = { dot: 6.5, group: 9, pulse: 16, hit: 18 };
    const small = () => matchMedia('(max-width: 640px)').matches;
    const scalePulses = (w: number) => {
      const k = w / Math.max(1, svg.clientWidth || svg.getBoundingClientRect().width), m = small() ? 0.8 : 1;
      root.querySelectorAll<SVGCircleElement>('.omap__pulse').forEach((c) => c.setAttribute('r', String(PX.pulse * m * k)));
      root.querySelectorAll<SVGCircleElement>('.omap__hit').forEach((c) => c.setAttribute('r', String(PX.hit * k)));
      root.querySelectorAll<SVGCircleElement>('.omap__dot').forEach((c) => c.setAttribute('r', String((c.closest('.omap__pin--group') ? PX.group : PX.dot) * m * k)));
    };
    const currentW = () => Number(svg.getAttribute('viewBox')!.split(' ')[2]);
    scalePulses(currentW());
    window.addEventListener('resize', () => scalePulses(currentW()));
    const boxFor = (ps: SVGGElement[]) => {
      const pts = ps.map((p) => { const c = p.querySelector('circle')!; return [Number(c.getAttribute('cx')), Number(c.getAttribute('cy'))]; });
      const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]); const [W, H] = world.split(' ').slice(2).map(Number);
      let w = Math.max(70, (Math.max(...xs) - Math.min(...xs)) * 1.9), h = w * H / W; const need = (Math.max(...ys) - Math.min(...ys)) * 1.9; if (need > h) { h = need; w = h * W / H; }
      return `${(Math.max(...xs) + Math.min(...xs)) / 2 - w / 2} ${(Math.max(...ys) + Math.min(...ys)) / 2 - h / 2} ${w} ${h}`;
    };
    const parentOf = (id: string) => groupPins.find((g) => g.dataset.group === id)?.dataset.parent || '';
    const view = (id: string) => {
      zoomed = id;
      let fine: SVGGElement | undefined; for (let z = id; z && !fine; z = parentOf(z)) fine = fines.find((f) => f.dataset.fine === z);
      fines.forEach((f) => f.classList.toggle('is-off', f !== fine)); worldLand.forEach((l) => l.classList.toggle('is-off', !!fine));
      pins.forEach((p) => p.classList.toggle('is-off', (p.dataset.zoom || '') !== id));
      groupPins.forEach((g) => g.classList.toggle('is-off', (g.dataset.parent || '') !== id));
      setView(id ? (fine?.dataset.fine === id && fine.dataset.box) || boxFor([...pins.filter((p) => p.dataset.zoom === id), ...groupPins.filter((g) => g.dataset.parent === id)]) : world);
      back.hidden = !id;
    };
    const zoomTo = (id: string) => view(id);
    const toWorld = () => view('');

    const showTip = (pin: SVGGElement) => {
      const r = pin.querySelector('.omap__dot')!.getBoundingClientRect(), s = root.querySelector('.omap__stage')!.getBoundingClientRect();
      if (!r.width) return;
      tipName.textContent = pin.dataset.label || '';
      tipCount.textContent = `${pin.dataset.count} ${Number(pin.dataset.count) === 1 ? root.dataset.one || 'engagement' : root.dataset.many || 'engagements'}`;
      tip.style.left = `${r.left + r.width / 2 - s.left}px`; tip.style.top = `${r.top - s.top}px`; tip.hidden = false;
    };
    const hideTip = () => { tip.hidden = true; };

    const select = (pin: SVGGElement) => {
      pins.forEach((p) => p.classList.toggle('is-active', p === pin));
      const key = pin.dataset.pin!;
      panel.querySelectorAll<HTMLElement>('[data-list]').forEach((l) => { l.hidden = l.dataset.list !== key; });
      cityEl.textContent = pin.dataset.label || ''; panel.hidden = false;
      rows.forEach((r) => { r.hidden = r.dataset.rowCity !== key; });
      document.querySelectorAll<HTMLElement>('[data-region]').forEach((s) => { s.hidden = !s.querySelector('[data-row-city]:not([hidden])'); });
      showTip(pin);
    };
    const showAll = () => { pins.forEach((p) => p.classList.remove('is-active')); panel.hidden = true; rows.forEach((r) => { r.hidden = false; }); document.querySelectorAll<HTMLElement>('[data-region]').forEach((s) => { s.hidden = false; }); hideTip(); };

    const hoverable = (pin: SVGGElement) => {
      pin.addEventListener('pointerenter', () => showTip(pin)); pin.addEventListener('focus', () => showTip(pin));
      pin.addEventListener('pointerleave', () => { if (!pin.classList.contains('is-active')) hideTip(); }); pin.addEventListener('blur', () => { if (!pin.classList.contains('is-active')) hideTip(); });
    };
    pins.forEach((pin) => {
      const act = () => { const z = pin.dataset.zoom || ''; if (zoomed !== z) zoomTo(z); else select(pin); };
      pin.addEventListener('click', act);
      pin.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
      hoverable(pin);
    });
    groupPins.forEach((pin) => {
      const act = () => { hideTip(); zoomTo(pin.dataset.group!); };
      pin.addEventListener('click', act);
      pin.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); act(); } });
      hoverable(pin);
    });
    back.addEventListener('click', () => { toWorld(); hideTip(); });
    root.querySelector('[data-all]')!.addEventListener('click', showAll);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !back.hidden) { toWorld(); hideTip(); } });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
