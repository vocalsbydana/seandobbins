---
/** Privacy-enhanced, click-to-load YouTube embed. Loads the iframe only after the poster is clicked. */
interface Props { id: string; title: string; class?: string; poster?: 'maxres' | 'hq'; vertical?: boolean }
const { id, title, class: cls = '', poster = 'maxres', vertical = false } = Astro.props;
// Shorts publish a portrait poster as oar2.jpg; fall back to the landscape poster if it's missing.
const thumb = vertical ? `https://i.ytimg.com/vi/${id}/oar2.jpg` : `https://i.ytimg.com/vi/${id}/${poster === 'maxres' ? 'maxresdefault' : 'hqdefault'}.jpg`;
const fallback = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class:list={['yt', cls, { 'yt--vertical': vertical }]} data-yt={id} data-title={title}>
  <img src={thumb} alt="" loading="lazy" decoding="async" width={vertical ? 720 : 1280} height={vertical ? 1280 : 720} onerror={`this.onerror=null;this.src='${fallback}'`} />
  <button type="button" class="yt__play" aria-label={`Play video: ${title}`}>
    <span class="yt__ring"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
    <span class="yt__label">Watch</span>
  </button>
</div>
<style>
  .yt { position: relative; aspect-ratio: 16 / 9; background: var(--ink); overflow: hidden; }
  .yt--vertical { aspect-ratio: 9 / 16; }
  .yt--vertical .yt__ring { width: 56px; height: 56px; }
  .yt img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.2); transition: transform 1.2s var(--ease-out), filter var(--dur); }
  .yt:hover img { transform: scale(1.03); filter: grayscale(0); }
  .yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt__play { position: absolute; inset: 0; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--ivory); background: linear-gradient(to top, rgba(18,18,106,.55), rgba(18,18,106,.08)); }
  .yt__ring { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; border: 3px solid var(--ivory); background: rgba(11,11,20,.35); transition: transform var(--dur) var(--ease-out), background var(--dur); }
  .yt__play:hover .yt__ring { transform: scale(1.08); background: var(--royal); }
  .yt__label { font-size: 12px; letter-spacing: var(--track-label); text-transform: uppercase; }
</style>
<script>
  function bind() {
    document.querySelectorAll<HTMLElement>('.yt:not([data-bound])').forEach((el) => {
      el.dataset.bound = '1';
      el.querySelector('.yt__play')?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = el.dataset.title || 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        el.replaceChildren(iframe);
      });
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
