---
import Wordmark from './Wordmark.astro';
import SocialIcons from './SocialIcons.astro';
import { NAV } from '../lib/site';
import T from './T.astro';
import { copy } from '../lib/copy';
const f = copy.global.footer;
const year = new Date().getFullYear();
---
<footer class="site-footer dark">
  <div class="container container--wide">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Wordmark size={34} />
        <p class="small muted"><T k="global.footer.tagline" /><br /><T k="global.footer.place" /></p>
      </div>
      <nav aria-label="Footer">
        <ul role="list" class="site-footer__nav">
          {NAV.map((i) => <li><a href={i.href} data-edit={i.key}>{i.label}</a></li>)}
          <li><a href="/barbershop/resources" data-edit="global.footer.freeResources">{f.freeResources}</a></li>
          <li><a href="/contact" data-edit="global.nav.contact">{copy.global.nav.contact}</a></li>
        </ul>
      </nav>
      <div class="site-footer__social">
        <T k="global.footer.follow" as="div" class="label" />
        <SocialIcons />
        <a href="/barbershop" class="site-footer__bs" aria-label="The Barbershop">
          <span class="bs-ring"><span></span></span>
          <T k="global.footer.barbershop" as="span" class="bs-text" />
        </a>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} Sean Dobbins. <T k="global.footer.rights" /></span>
      <T k="global.footer.photoCredit" as="span" class="site-footer__credit" />
      <a href="/admin" class="site-footer__admin" rel="nofollow" data-edit="global.footer.edit">{f.edit}</a>
    </div>
  </div>
</footer>
<style>
  .site-footer { padding: clamp(48px, 7vw, 88px) 0 var(--s-4); }
  .site-footer__top { display: grid; gap: var(--s-5); padding-bottom: var(--s-5); border-bottom: var(--hairline-dark); }
  @media (min-width: 720px) { .site-footer__top { grid-template-columns: 1.4fr 1fr 1fr; } }
  .site-footer__brand { display: flex; flex-direction: column; gap: var(--s-2); }
  .site-footer__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; }
  .site-footer a:not(.btn) { font-size: 12px; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--ivory-65); }
  .site-footer a:not(.btn):hover { color: var(--brass); }
  .site-footer__social { display: flex; flex-direction: column; gap: var(--s-2); }
  .site-footer__bs { display: inline-flex; align-items: center; gap: 12px; margin-top: var(--s-2); }
  .bs-ring { width: 30px; height: 30px; border-radius: 50%; padding: 3px; background: repeating-linear-gradient(135deg, var(--royal) 0 4px, var(--ivory) 4px 8px, var(--brass) 8px 12px); display: block; }
  .bs-ring span { display: block; width: 100%; height: 100%; border-radius: 50%; background: var(--ink); }
  .bs-text { font-family: var(--font-display) !important; font-size: 20px !important; letter-spacing: .04em !important; text-transform: uppercase; color: var(--ivory) !important; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; padding-top: var(--s-3); font-size: 12px; color: var(--ivory-55); }
  .site-footer__credit { flex: 1; }
  .site-footer__admin { font-size: 12px !important; letter-spacing: .06em !important; text-transform: none !important; }
</style>
