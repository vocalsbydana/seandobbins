---
import Base from '../layouts/Base.astro';
import AuralisFeed from '../components/AuralisFeed.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import T from '../components/T.astro';
const description = 'Upcoming dates for Sean Dobbins: trio, quartet and sideman gigs in Detroit, Bloomington and on the road. Add any show to your calendar.';
---
<Base title="Gigs" description={description}>
  <section class="section">
    <div class="container">
      <SectionHead numKey="gigs.page.num" titleKey="gigs.page.title" as="h1" blurbKey="gigs.page.blurb" />
      <!-- AURALIS PLACEHOLDER: see src/components/AuralisFeed.astro -->
      <AuralisFeed />
      <T k="gigs.page.note" as="p" class="note small muted" data-reveal />
    </div>
  </section>
  <section class="section--tight stage">
    <div class="container">
      <NewsletterForm headingKey="gigs.newsletter.heading" blurbKey="gigs.newsletter.blurb" source="gigs" />
    </div>
  </section>
</Base>
<style>.note { margin-top: var(--s-3); }</style>
