---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AuralisFeed from '../components/AuralisFeed.astro';
import Marquee from '../components/Marquee.astro';
import Mark from '../components/Mark.astro';
import ResourceCard from '../components/ResourceCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import BarbershopBadge from '../components/BarbershopBadge.astro';
import SectionHead from '../components/SectionHead.astro';
import T from '../components/T.astro';
import stageBlue from '../assets/photos/stage-blue.jpg';
import bwStars from '../assets/photos/bw-stars.jpg';
import { SITE, fmtDate } from '../lib/site';
import { copy } from '../lib/copy';

const c = copy.home;
const resources = (await getCollection('resources')).sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const latest = resources.find((r) => r.data.featured) ?? resources[0];
const announcements = (await getCollection('announcements')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const announcement = announcements[0];
---
<Base title={SITE.name} description={SITE.description}>
  <!-- Hero · the brand guide cover -->
  <section class="hero dark" aria-label="Sean Dobbins">
    <div class="hero__photo" aria-hidden="true">
      <Image src={stageBlue} alt="" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__inner">
      <div class="hero__top">
        <T k="home.hero.eyebrow" />
        <T k="home.hero.topRight" class="hero__top-right" />
      </div>
      <div class="hero__lockup">
        <div class="hero__name-row">
          <Mark size={120} color="var(--ivory)" spin class="hero__mark" />
          <h1 class="hero__name"><span>Sean</span><span>Dobbins</span></h1>
        </div>
        <div class="hero__rule" aria-hidden="true"></div>
        <T k="home.hero.tagline" as="p" class="hero__tagline" />
      </div>
      <div class="hero__bottom">
        <T k="home.hero.place" class="hero__place" />
        <div class="hero__actions">
          <a href="/music" class="btn btn--primary" data-edit="home.hero.listen">{c.hero.listen}</a>
          <a href="/contact" class="btn btn--secondary" data-edit="home.hero.book">{c.hero.book}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="creed stage">
    <div class="container creed__inner">
      <T k="home.creed.title" as="p" class="creed__title display-2" data-reveal />
      <p class="voice creed__quote" data-reveal style="--reveal-delay:120ms">“<T k="home.creed.quote" />”<T k="home.creed.who" class="label creed__who" /></p>
    </div>
  </section>

  {announcement && (
    <a href={announcement.data.link ?? '/gigs'} class="ticker" aria-label={`Announcement: ${announcement.data.title}`}>
      <div class="container container--wide ticker__inner">
        <T k="home.ticker.label" class="label" />
        <span class="ticker__title">{announcement.data.title}</span>
        <span class="ticker__date small">{fmtDate(announcement.data.date)}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
    </a>
  )}

  <!-- Next gig -->
  <section class="section">
    <div class="container">
      <SectionHead numKey="home.next.num" titleKey="home.next.title" blurbKey="home.next.blurb" />
      <AuralisFeed limit={3} />
      <p class="section__more" data-reveal><a href="/gigs" class="link"><T k="home.next.more" /> <span class="arrow">→</span></a></p>
    </div>
  </section>

  <!-- Bio teaser -->
  <section class="section bio-teaser stage">
    <div class="container bio-teaser__inner">
      <div class="photo photo--bw bio-teaser__photo" data-reveal="scale">
        <Image src={bwStars} alt="Sean Dobbins at the drums, black and white. Photo: Mark Sheldon." widths={[600, 1000, 1400]} sizes="(min-width: 900px) 46vw, 100vw" />
      </div>
      <div class="bio-teaser__copy" data-reveal>
        <T k="home.bio.label" as="p" class="label" />
        <T k="home.bio.title" as="h2" class="display-2" />
        <T k="home.bio.text" as="p" class="lede" />
        <a href="/about" class="link"><T k="home.bio.more" /> <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Played with -->
  <section class="section--tight played dark">
    <div class="container container--wide">
      <T k="home.played.label" as="p" class="label played__label" data-reveal />
    </div>
    <Marquee items={copy.about.playedWith} keyPrefix="about.playedWith" />
  </section>

  <!-- Latest resource / Barbershop -->
  <section class="section">
    <div class="container">
      <SectionHead numKey="home.barbershop.num" titleKey="home.barbershop.title" blurbKey="home.barbershop.blurb">
        <BarbershopBadge size={96} />
      </SectionHead>
      <div class="latest">
        {latest && <ResourceCard slug={latest.data.slug} title={latest.data.title} description={latest.data.description} topic={latest.data.topic} cover={latest.data.cover || undefined} featured />}
        <div class="latest__aside paper" data-reveal style="--reveal-delay:120ms">
          <T k="home.barbershop.asideLabel" as="p" class="label" />
          <T k="home.barbershop.asideTitle" as="h3" class="display-3" />
          <T k="home.barbershop.asideText" as="p" class="small muted" />
          <a href="/barbershop#study" class="link"><T k="home.barbershop.asideLink" /> <span class="arrow">→</span></a>
        </div>
      </div>
      <p class="section__more" data-reveal><a href="/barbershop/resources" class="link"><T k="home.barbershop.more" /> <span class="arrow">→</span></a></p>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section--tight">
    <div class="container">
      <div class="paper newsletter-panel" data-reveal>
        <NewsletterForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: min(calc(100svh - 64px), 880px); display: flex; }
  .hero__photo { position: absolute; inset: 0; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 20%; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,20,.92) 0%, rgba(11,11,20,.75) 38%, rgba(11,11,20,0) 70%); }
  .hero__inner { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-6); padding: clamp(24px, 4vw, 54px) var(--gutter) clamp(28px, 4vw, 54px); max-width: 1440px; width: 100%; margin-inline: auto; }
  .hero__top, .hero__place { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }
  .hero__top { display: flex; justify-content: space-between; gap: var(--s-3); color: var(--brass); }
  .hero__top-right { text-align: right; }
  .hero__lockup { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .hero__name-row { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 30px); }
  .hero__name { display: flex; flex-direction: column; font-size: clamp(72px, 11.5vw, 148px); line-height: .86; letter-spacing: .01em; color: var(--ivory); }
  .hero__rule { width: 64px; height: 3px; background: var(--brass); }
  .hero__tagline { font-family: var(--font-voice); font-style: italic; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.3; color: var(--ivory); text-wrap: pretty; max-width: 46ch; }
  .hero__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); }
  .hero__place { color: var(--ivory-65); }
  .hero__actions { display: flex; gap: var(--s-2); }
  @media (max-width: 640px) {
    .hero__top-right { display: none; }
    .hero :global(.hero__mark) { --mark-size: 60px !important; --mark-stroke: 5px !important; --mark-stick: 3px !important; --mark-dot: 6px !important; }
    .hero__name-row { gap: 14px; }
    .hero__photo img { object-position: 62% 20%; }
    .hero__shade { background: linear-gradient(180deg, rgba(11,11,20,.55) 0%, rgba(11,11,20,.35) 30%, rgba(11,11,20,.88) 62%, rgba(11,11,20,.95) 100%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__name span { animation: word-up .9s var(--ease-out) both; } .hero__name span:nth-child(2) { animation-delay: .12s; }
    .hero__rule { animation: rule-in .8s var(--ease-out) .45s both; transform-origin: left; }
    .hero__tagline, .hero__bottom, .hero__top { animation: fade-up .8s var(--ease-out) .55s both; }
    .hero__photo img { animation: wash-in 2.4s var(--ease-out) both; }
  }
  @keyframes word-up { from { opacity: 0; transform: translateY(.4em); } }
  @keyframes rule-in { from { transform: scaleX(0); } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(12px); } }
  @keyframes wash-in { from { transform: scale(1.06); opacity: 0; } }

  .creed { padding-block: clamp(40px, 6vw, 72px); }
  .creed__inner { display: grid; gap: var(--s-3); align-items: center; }
  @media (min-width: 900px) { .creed__inner { grid-template-columns: 1fr 1.2fr; gap: var(--s-8); } }
  .creed__quote { display: flex; flex-direction: column; gap: 12px; color: var(--ivory-80); border-left: 3px solid var(--brass); padding-left: var(--s-3); }
  .creed__who { color: var(--brass); }

  .ticker { display: block; background: var(--royal); color: var(--ivory); }
  .ticker:hover { color: var(--ivory); background: var(--stage); }
  .ticker__inner { display: flex; align-items: center; gap: var(--s-2); padding-block: 12px; }
  .ticker .label { color: var(--ivory); opacity: .8; }
  .ticker__title { font-weight: 600; flex: 1; font-size: 15px; }
  .ticker__date { opacity: .75; }
  .ticker .arrow { transition: transform var(--dur-fast) var(--ease-out); }
  .ticker:hover .arrow { transform: translateX(4px); }

  .section__more { margin-top: var(--s-4); }

  .bio-teaser__inner { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 900px) { .bio-teaser__inner { grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); } }
  .bio-teaser__photo { aspect-ratio: 4 / 3; }
  .bio-teaser__copy { display: flex; flex-direction: column; gap: var(--s-3); }
  .bio-teaser__copy .lede { color: var(--ivory-80); }

  .played { padding-block: var(--s-6) var(--s-8); }
  .played__label { margin-bottom: var(--s-3); }

  .latest { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .latest { grid-template-columns: 2fr 1fr; } }
  .latest__aside { padding: 28px; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .newsletter-panel { padding: clamp(24px, 4vw, 48px); }
</style>
