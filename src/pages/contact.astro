---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import T from '../components/T.astro';
import { copy } from '../lib/copy';
const c = copy.contact;
const description = 'Book Sean Dobbins for a gig, a clinic, a masterclass or a residency. One form, straight to his inbox.';
---
<Base title="Contact" description={description}>
  <section class="section">
    <div class="container contact">
      <div class="contact__copy">
        <SectionHead numKey="contact.page.num" titleKey="contact.page.title" as="h1" blurbKey="contact.page.blurb" />
        <dl class="contact__facts" data-reveal>
          <div><T k="contact.facts.basedLabel" as="dt" class="label" /><T k="contact.facts.based" as="dd" /></div>
          <div><T k="contact.facts.bookingLabel" as="dt" class="label" /><dd>{c.facts.bookingEmail ? <a class="link" href={`mailto:${c.facts.bookingEmail}`} data-edit="contact.facts.bookingEmail">{c.facts.bookingEmail}</a> : <T k="contact.facts.bookingFallback" />}</dd></div>
          <div><T k="contact.facts.studentsLabel" as="dt" class="label" /><dd><a class="link" href="/barbershop#study" data-edit="contact.facts.studentsLink">{c.facts.studentsLink}</a></dd></div>
        </dl>
      </div>
      <form class="contact__form paper" data-contact data-success={c.form.success} novalidate data-reveal style="--reveal-delay:120ms">
        <div class="field"><label for="c-name" data-edit="contact.form.name">{c.form.name}</label><input id="c-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="c-email" data-edit="contact.form.email">{c.form.email}</label><input id="c-email" name="email" type="email" autocomplete="email" required placeholder={c.form.emailPlaceholder} /></div>
        <div class="field"><label for="c-subject" data-edit="contact.form.subject">{c.form.subject}</label>
          <select id="c-subject" name="subject">{c.form.subjects.map((s, i) => <option data-edit={`contact.form.subjects.${i}`}>{s}</option>)}</select></div>
        <div class="field"><label for="c-message" data-edit="contact.form.message">{c.form.message}</label><textarea id="c-message" name="message" rows="6" required placeholder={c.form.messagePlaceholder}></textarea></div>
        <label class="hp" aria-hidden="true">Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn btn--primary" type="submit" data-edit="contact.form.button">{c.form.button}</button>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--s-5); }
  @media (min-width: 900px) { .contact { grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; } }
  .contact__facts { display: flex; flex-direction: column; }
  .contact__facts > div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 12px 0; border-top: var(--hairline); font-size: 15px; }
  .contact__facts > div:last-child { border-bottom: var(--hairline); }
  .contact__form { display: flex; flex-direction: column; gap: 14px; padding: clamp(20px, 3vw, 32px); }
  .form-msg:empty { display: none; }
  .form-msg { font-weight: 600; font-size: 14px; }
  .form-msg.is-error { color: var(--walnut); }
</style>
<script>
  function bind() {
    const form = document.querySelector<HTMLFormElement>('form[data-contact]:not([data-bound])');
    if (!form) return; form.dataset.bound = '1';
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form); const payload: Record<string, string> = {};
      fd.forEach((v, k) => { payload[k === 'website' ? 'hp' : k] = String(v); });
      msg.className = 'form-msg';
      if (!payload.name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email) || (payload.message || '').trim().length < 10) { msg.textContent = 'Please add your name, a valid email, and a message.'; msg.classList.add('is-error'); return; }
      const label = btn.textContent || 'Send message';
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');
        form.querySelectorAll('.field, button').forEach((el) => el.setAttribute('hidden', ''));
        msg.textContent = form.dataset.success || 'Sent.';
      } catch (err) { msg.textContent = (err as Error).message; msg.classList.add('is-error'); btn.disabled = false; btn.textContent = label; }
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
