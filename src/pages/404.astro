---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import T from '../components/T.astro';
---
<Base title="Not found" noindex ogImage="/og/home.png">
  <section class="section dark nf">
    <div class="container nf__inner">
      <Mark size={72} spin />
      <T k="notfound.title" as="h1" class="display-1" />
      <T k="notfound.text" as="p" class="lede" />
      <div class="nf__actions"><a href="/" class="btn btn--primary"><T k="notfound.home" /></a><a href="/barbershop/resources" class="link"><T k="notfound.resources" /> <span class="arrow">→</span></a></div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 60vh; display: flex; align-items: center; }
  .nf__inner { display: flex; flex-direction: column; gap: var(--s-3); align-items: flex-start; }
  .nf__actions { display: flex; align-items: center; gap: var(--s-3); }
</style>
