---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BarbershopBadge from '../../components/BarbershopBadge.astro';
import Pole from '../../components/Pole.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import T from '../../components/T.astro';
import { copy } from '../../lib/copy';
import kit from '../../assets/photos/stage-kit.jpg';

const c = copy.barbershop;
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const resources = (await getCollection('resources')).sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()).slice(0, 3);
const description = "The Barbershop is Sean Dobbins' jazz drumset studio at the Indiana University Jacobs School of Music, and a free library of drum resources for everyone else. Serve the music. Keep the joy.";
---
<Base title="The Barbershop" description={description}>
  <section class="bs-hero dark">
    <div class="container bs-hero__inner">
      <BarbershopBadge size={200} class="bs-hero__badge" />
      <div class="bs-hero__copy">
        <T k="barbershop.hero.label" as="p" class="label" />
        <T k="barbershop.hero.title" as="h1" class="bs-hero__title" />
        <T k="barbershop.hero.lede" as="p" class="lede" />
        <div class="bs-hero__actions">
          <a href="/barbershop/resources" class="btn btn--primary" data-edit="barbershop.hero.resources">{c.hero.resources}</a>
          <a href="#study" class="btn btn--secondary" data-edit="barbershop.hero.study">{c.hero.study}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container philosophy">
      <div class="philosophy__copy prose" data-reveal>
        <SectionHead numKey="barbershop.philosophy.num" titleKey="barbershop.philosophy.title" as="h2" />
        <p class="lede"><T k="barbershop.philosophy.lede" as="strong" /></p>
        {c.philosophy.paragraphs.map((_, i) => <T k={`barbershop.philosophy.paragraphs.${i}`} as="p" />)}
      </div>
      <div class="philosophy__aside">
        <blockquote class="voice philosophy__quote" data-reveal style="--reveal-delay:120ms">
          “<T k="barbershop.philosophy.quote" />”
          <T k="barbershop.philosophy.who" as="footer" class="label" />
        </blockquote>
        <div class="photo philosophy__photo" data-reveal="scale" style="--reveal-delay:220ms">
          <Image src={kit} alt="Sean at a Yamaha kit against blue curtains, mid-phrase." widths={[500, 900]} sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section stage testimonials">
    <div class="container">
      <SectionHead numKey="barbershop.testimonials.num" titleKey="barbershop.testimonials.title" blurbKey="barbershop.testimonials.blurb" />
      <ul role="list" class="tgrid">
        {testimonials.map((t, i) => (
          <li class="tcard" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <p class="tcard__quote voice">“{t.data.quote}”</p>
            <div class="tcard__who">
              {t.data.photo ? <img src={t.data.photo} alt="" width="48" height="48" loading="lazy" /> : <span class="tcard__avatar" aria-hidden="true">{t.data.name.charAt(0)}</span>}
              <div><div class="tcard__name">{t.data.name}</div><div class="tcard__role">{t.data.role}</div></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead numKey="barbershop.resources.num" titleKey="barbershop.resources.title" blurbKey="barbershop.resources.blurb" />
      <div class="grid grid-3">
        {resources.map((r, i) => <ResourceCard slug={r.data.slug} title={r.data.title} description={r.data.description} topic={r.data.topic} cover={r.data.cover || undefined} index={i} />)}
      </div>
      <p class="more" data-reveal><a href="/barbershop/resources" class="link"><T k="barbershop.resources.more" /> <span class="arrow">→</span></a></p>
    </div>
  </section>

  <section class="section dark study" id="study">
    <div class="container study__inner">
      <div class="study__copy">
        <SectionHead numKey="barbershop.study.num" titleKey="barbershop.study.title" blurbKey="barbershop.study.blurb" />
        <div class="prose">
          <T k="barbershop.study.text" as="p" />
          <ul>
            {c.study.links.map((l, i) => <li><a href={l.url} target="_blank" rel="noopener" data-edit={`barbershop.study.links.${i}.label`}>{l.label}</a></li>)}
          </ul>
        </div>
        <Pole height={200} class="study__pole" />
      </div>
      <form class="study__form paper" data-prospective data-success={c.form.success} novalidate>
        <T k="barbershop.form.label" as="p" class="label" />
        <T k="barbershop.form.intro" as="p" class="small" />
        <div class="field"><label for="ps-name" data-edit="barbershop.form.name">{c.form.name}</label><input id="ps-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="ps-email" data-edit="barbershop.form.email">{c.form.email}</label><input id="ps-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="ps-program" data-edit="barbershop.form.program">{c.form.program}</label>
          <select id="ps-program" name="program">{c.form.programs.map((p, i) => <option data-edit={`barbershop.form.programs.${i}`}>{p}</option>)}</select></div>
        <div class="field"><label for="ps-year" data-edit="barbershop.form.year">{c.form.year}</label><input id="ps-year" name="year" type="text" inputmode="numeric" placeholder={c.form.yearPlaceholder} /></div>
        <div class="field"><label for="ps-city" data-edit="barbershop.form.city">{c.form.city}</label><input id="ps-city" name="city" type="text" placeholder={c.form.cityPlaceholder} /></div>
        <div class="field"><label for="ps-note"><T k="barbershop.form.note" /> <span class="hint">(optional)</span></label><textarea id="ps-note" name="note" rows="3"></textarea></div>
        <label class="hp" aria-hidden="true">Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn btn--primary" type="submit" data-edit="barbershop.form.button">{c.form.button}</button>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .bs-hero { padding-block: clamp(48px, 8vw, 112px); }
  .bs-hero__inner { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 800px) { .bs-hero__inner { grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 80px); } }
  .bs-hero__copy { display: flex; flex-direction: column; gap: var(--s-3); }
  .bs-hero__title { font-family: var(--font-text); text-transform: none; font-weight: 700; font-size: clamp(36px, 5.6vw, 72px); line-height: 1; letter-spacing: -.025em; }
  .bs-hero__copy .lede { color: var(--ivory-80); max-width: 60ch; }
  .bs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (prefers-reduced-motion: no-preference) { .bs-hero__copy > * { animation: up .8s var(--ease-out) both; } .bs-hero__copy > :nth-child(2) { animation-delay: .1s; } .bs-hero__copy > :nth-child(3) { animation-delay: .2s; } .bs-hero__copy > :nth-child(4) { animation-delay: .3s; } }
  @keyframes up { from { opacity: 0; transform: translateY(14px); } }

  .philosophy { display: grid; gap: var(--s-6); }
  @media (min-width: 900px) { .philosophy { grid-template-columns: 1.3fr 1fr; gap: clamp(40px, 6vw, 96px); } }
  .philosophy__aside { display: flex; flex-direction: column; gap: var(--s-4); }
  .philosophy__quote { border-left: 3px solid var(--brass); padding-left: var(--s-3); display: flex; flex-direction: column; gap: 12px; }
  .philosophy__photo { aspect-ratio: 4 / 5; }

  .tgrid { display: grid; gap: var(--s-3); }
  @media (min-width: 800px) { .tgrid { grid-template-columns: repeat(3, 1fr); } }
  .tcard { border-top: 1px solid var(--brass); padding-top: var(--s-3); display: flex; flex-direction: column; gap: var(--s-3); }
  .tcard__quote { font-size: clamp(20px, 1.8vw, 24px); flex: 1; }
  .tcard__who { display: flex; align-items: center; gap: 12px; }
  .tcard__who img, .tcard__avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; }
  .tcard__avatar { display: grid; place-items: center; background: var(--royal); color: var(--ivory); font-family: var(--font-display); font-size: 22px; }
  .tcard__name { font-weight: 600; font-size: 14px; }
  .tcard__role { font-size: 12px; color: var(--ivory-65); letter-spacing: .06em; }
  .more { margin-top: var(--s-4); }

  .study__inner { display: grid; gap: var(--s-6); }
  @media (min-width: 960px) { .study__inner { grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; } }
  .study__copy { position: relative; }
  .study__pole { margin-top: var(--s-6); }
  .study__form { display: flex; flex-direction: column; gap: 14px; padding: clamp(20px, 3vw, 32px); color: var(--ink); }
  .study__form .label { color: var(--walnut); }
  .form-msg:empty { display: none; }
  .form-msg { font-weight: 600; font-size: 14px; }
  .form-msg.is-error { color: var(--walnut); }
</style>
<script>
  function bind() {
    const form = document.querySelector<HTMLFormElement>('form[data-prospective]:not([data-bound])');
    if (!form) return; form.dataset.bound = '1';
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload: Record<string, string> = {};
      fd.forEach((v, k) => { payload[k === 'website' ? 'hp' : k] = String(v); });
      msg.className = 'form-msg';
      if (!payload.name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email)) { msg.textContent = 'Please add your name and a valid email.'; msg.classList.add('is-error'); return; }
      const label = btn.textContent || 'Send';
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/prospective', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');
        form.querySelectorAll('.field, button').forEach((el) => el.setAttribute('hidden', ''));
        msg.textContent = form.dataset.success || 'Got it.';
      } catch (err) {
        msg.textContent = (err as Error).message; msg.classList.add('is-error'); btn.disabled = false; btn.textContent = label;
      }
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
