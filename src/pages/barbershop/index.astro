---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BarbershopBadge from '../../components/BarbershopBadge.astro';
import Pole from '../../components/Pole.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import jacobs from '../../data/jacobs.json';
import kit from '../../assets/photos/stage-kit.jpg';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const resources = (await getCollection('resources')).sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()).slice(0, 3);
const description = "The Barbershop is Sean Dobbins' jazz drumset studio at the Indiana University Jacobs School of Music, and a free library of drum resources for everyone else. Serve the music. Keep the joy.";
---
<Base title="The Barbershop" description={description}>
  <section class="bs-hero dark">
    <div class="container bs-hero__inner">
      <BarbershopBadge size={200} class="bs-hero__badge" />
      <div class="bs-hero__copy">
        <p class="label">Sub-brand · Education</p>
        <h1 class="bs-hero__title">A weekly hang,<br />not a class.</h1>
        <p class="lede">The Barbershop is where Sean's students at IU meet, listen, argue, and play. Here it houses his teaching: the philosophy, the studio, the outreach, and a library of free resources for any drummer who wants them.</p>
        <div class="bs-hero__actions">
          <a href="/barbershop/resources" class="btn btn--primary">Free resources</a>
          <a href="#study" class="btn btn--secondary">Study with Sean</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container philosophy">
      <div class="philosophy__copy prose" data-reveal>
        <SectionHead num="01" title="How Sean teaches" as="h2" />
        <p class="lede"><strong>Two rules. Serve the music. Keep the joy.</strong></p>
        <p>Everything else in the studio hangs off those two. Time, touch, reading, vocabulary: they matter because they let you take care of the band. A drummer who makes the bass player comfortable, who hears the pianist's left hand and stays out of its way, who knows the melody of the tune they're playing, is a drummer who gets called back. That is the whole job, and it is a joyful one.</p>
        <p>Lessons are built around the bandstand, not the practice room. Students transcribe, they play with records, they play with each other, and they play in public as early as Sean can get them there. Mistakes are information. Ego is noise.</p>
        <p>The Barbershop itself is the weekly hang: the whole studio in one room, listening to something, arguing about it, and then playing it. Nobody is graded. Everybody plays.</p>
        <p class="small todo">DRAFT COPY. Written from the brief's brand voice for Sean to edit or replace in code (src/pages/barbershop/index.astro).</p>
      </div>
      <div class="philosophy__aside">
        <blockquote class="voice philosophy__quote" data-reveal style="--reveal-delay:120ms">
          “You've got to make the band feel good before you make yourself sound good.”
          <footer class="label">Sean, to a student</footer>
        </blockquote>
        <div class="photo philosophy__photo" data-reveal="scale" style="--reveal-delay:220ms">
          <Image src={kit} alt="Sean at a Yamaha kit against blue curtains, mid-phrase." widths={[500, 900]} sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section stage testimonials">
    <div class="container">
      <SectionHead num="02" title="From the studio" blurb="Students, parents, and bandleaders. Sean adds these in the CMS." />
      <ul role="list" class="tgrid">
        {testimonials.map((t, i) => (
          <li class="tcard" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <p class="tcard__quote voice">“{t.data.quote}”</p>
            <div class="tcard__who">
              {t.data.photo ? <img src={t.data.photo} alt="" width="48" height="48" loading="lazy" /> : <span class="tcard__avatar" aria-hidden="true">{t.data.name.charAt(0)}</span>}
              <div><div class="tcard__name">{t.data.name}</div><div class="tcard__role">{t.data.role}</div></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead num="03" title="Free resources" blurb="PDFs from the studio. Leave your email once and everything unlocks, forever." />
      <div class="grid grid-3">
        {resources.map((r, i) => <ResourceCard slug={r.data.slug} title={r.data.title} description={r.data.description} topic={r.data.topic} cover={r.data.cover || undefined} index={i} />)}
      </div>
      <p class="more" data-reveal><a href="/barbershop/resources" class="link">Browse the whole library <span class="arrow">→</span></a></p>
    </div>
  </section>

  <section class="section dark study" id="study">
    <div class="container study__inner">
      <div class="study__copy">
        <SectionHead num="04" title="Study with Sean at Jacobs" blurb="Jazz drumset, Indiana University Jacobs School of Music, Bloomington." />
        <div class="prose">
          <p>The Jacobs School offers Bachelor of Music, Master of Music, and Doctor of Music degrees in Jazz Studies, and drummers in the program study with Sean. Applications go through Jacobs, not through this site; the links below are the official ones.</p>
          <ul>
            <li><a href={jacobs.jazzStudies} target="_blank" rel="noopener">Jazz Studies at Jacobs</a></li>
            <li><a href={jacobs.auditions} target="_blank" rel="noopener">Audition requirements and dates</a></li>
            <li><a href={jacobs.apply} target="_blank" rel="noopener">How to apply</a></li>
            <li><a href={jacobs.faculty} target="_blank" rel="noopener">Sean's faculty page</a></li>
          </ul>
          <p class="small todo">Links to verify before launch (src/data/jacobs.json).</p>
        </div>
        <Pole height={200} class="study__pole" />
      </div>
      <form class="study__form paper" data-prospective novalidate>
        <p class="label">Interested? Tell Sean you're coming.</p>
        <p class="small">Not an application. It just lets Sean know who's out there, so he can say hello before audition day.</p>
        <div class="field"><label for="ps-name">Name</label><input id="ps-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="ps-email">Email</label><input id="ps-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="ps-program">Program</label>
          <select id="ps-program" name="program"><option>Undergraduate (BM)</option><option>Master's (MM)</option><option>Doctoral (DM)</option><option>Not sure yet</option></select></div>
        <div class="field"><label for="ps-year">Hoping to start</label><input id="ps-year" name="year" type="text" inputmode="numeric" placeholder="Fall 2027" /></div>
        <div class="field"><label for="ps-city">Where are you now?</label><input id="ps-city" name="city" type="text" placeholder="City, State" /></div>
        <div class="field"><label for="ps-note">Anything Sean should know? <span class="hint">(optional)</span></label><textarea id="ps-note" name="note" rows="3"></textarea></div>
        <label class="hp" aria-hidden="true">Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn btn--primary" type="submit">Send</button>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .bs-hero { padding-block: clamp(48px, 8vw, 112px); }
  .bs-hero__inner { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 800px) { .bs-hero__inner { grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 80px); } }
  .bs-hero__copy { display: flex; flex-direction: column; gap: var(--s-3); }
  .bs-hero__title { font-family: var(--font-text); text-transform: none; font-weight: 700; font-size: clamp(36px, 5.6vw, 72px); line-height: 1; letter-spacing: -.025em; }
  .bs-hero__copy .lede { color: var(--ivory-80); max-width: 60ch; }
  .bs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  @media (prefers-reduced-motion: no-preference) { .bs-hero__copy > * { animation: up .8s var(--ease-out) both; } .bs-hero__copy > :nth-child(2) { animation-delay: .1s; } .bs-hero__copy > :nth-child(3) { animation-delay: .2s; } .bs-hero__copy > :nth-child(4) { animation-delay: .3s; } }
  @keyframes up { from { opacity: 0; transform: translateY(14px); } }

  .philosophy { display: grid; gap: var(--s-6); }
  @media (min-width: 900px) { .philosophy { grid-template-columns: 1.3fr 1fr; gap: clamp(40px, 6vw, 96px); } }
  .philosophy__aside { display: flex; flex-direction: column; gap: var(--s-4); }
  .philosophy__quote { border-left: 3px solid var(--brass); padding-left: var(--s-3); display: flex; flex-direction: column; gap: 12px; }
  .philosophy__photo { aspect-ratio: 4 / 5; }
  .todo { color: var(--brass); }

  .tgrid { display: grid; gap: var(--s-3); }
  @media (min-width: 800px) { .tgrid { grid-template-columns: repeat(3, 1fr); } }
  .tcard { border-top: 1px solid var(--brass); padding-top: var(--s-3); display: flex; flex-direction: column; gap: var(--s-3); }
  .tcard__quote { font-size: clamp(20px, 1.8vw, 24px); flex: 1; }
  .tcard__who { display: flex; align-items: center; gap: 12px; }
  .tcard__who img, .tcard__avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; }
  .tcard__avatar { display: grid; place-items: center; background: var(--royal); color: var(--ivory); font-family: var(--font-display); font-size: 22px; }
  .tcard__name { font-weight: 600; font-size: 14px; }
  .tcard__role { font-size: 12px; color: var(--ivory-65); letter-spacing: .06em; }
  .more { margin-top: var(--s-4); }

  .study__inner { display: grid; gap: var(--s-6); }
  @media (min-width: 960px) { .study__inner { grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; } }
  .study__copy { position: relative; }
  .study__pole { margin-top: var(--s-6); }
  .study__form { display: flex; flex-direction: column; gap: 14px; padding: clamp(20px, 3vw, 32px); color: var(--ink); }
  .study__form .label { color: var(--walnut); }
  .form-msg:empty { display: none; }
  .form-msg { font-weight: 600; font-size: 14px; }
  .form-msg.is-error { color: var(--walnut); }
</style>
<script>
  function bind() {
    const form = document.querySelector<HTMLFormElement>('form[data-prospective]:not([data-bound])');
    if (!form) return; form.dataset.bound = '1';
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload: Record<string, string> = {};
      fd.forEach((v, k) => { payload[k === 'website' ? 'hp' : k] = String(v); });
      msg.className = 'form-msg';
      if (!payload.name || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(payload.email)) { msg.textContent = 'Please add your name and a valid email.'; msg.classList.add('is-error'); return; }
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/prospective', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');
        form.querySelectorAll('.field, button').forEach((el) => el.setAttribute('hidden', ''));
        msg.textContent = 'Got it. Sean will be in touch. Check your inbox to confirm your email.';
      } catch (err) {
        msg.textContent = (err as Error).message; msg.classList.add('is-error'); btn.disabled = false; btn.textContent = 'Send';
      }
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
