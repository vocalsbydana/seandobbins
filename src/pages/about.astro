---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import T from '../components/T.astro';
import { copy } from '../lib/copy';
import profile from '../assets/photos/profile-brushes.jpg';
import laugh from '../assets/photos/laugh-warm.jpg';
import PhotoGallery from '../components/PhotoGallery.astro';
import type { ImageMetadata } from 'astro';
import people from '../data/played-with.json';

// Played-with photos. Two sources, checked in this order:
//  1. src/data/played-with.json entries with `file` → a photo in src/assets/people/ (Sean's own photos, credit in the entry).
//     Any entry may also carry `url` (the person's website): the name in the card links to it, or the name itself if there is no photo.
//  2. public/people/manifest.json → real, free-licensed photos fetched from Wikipedia/Wikimedia Commons at build
//     by scripts/fetch-people.mjs for entries with `wiki`, with photographer + licence pulled from Commons.
// Names with neither render as plain text. Matching is by name, so renaming a person in the editor unlinks the photo.
import { readFileSync } from 'node:fs';
const peopleMods = import.meta.glob<{ default: ImageMetadata }>('../assets/people/*.{jpg,jpeg,png,webp}', { eager: true });
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
type Fetched = { name: string; src: string; artist?: string; license?: string; licenseUrl?: string; source?: string };
let fetched: Fetched[] = [];
try { fetched = JSON.parse(readFileSync(`${process.cwd()}/public/people/manifest.json`, 'utf8')); } catch { /* not staged (offline build) */ }
type Entry = { name: string; file?: string; credit?: string; url?: string; wiki?: string[] };
const entryFor = (name: string) => (people as Entry[]).find((x) => slug(x.name) === slug(name));
const photoFor = (name: string) => {
  const p = entryFor(name);
  const mod = p && 'file' in p && Object.entries(peopleMods).find(([k]) => k.endsWith('/' + (p as { file: string }).file));
  if (p && mod) return { img: mod[1].default as ImageMetadata, src: undefined, credit: p.credit || '', license: '', source: '', url: p.url || '' };
  const f = fetched.find((x) => slug(x.name) === slug(name));
  if (f) return { img: undefined, src: f.src, credit: f.artist || '', license: f.license || '', source: f.source || '', url: p?.url || '' };
  return null;
};

const c = copy.about;
const description = 'Sean Dobbins, jazz drummer: Detroit sideman, bandleader, Woody Herman Jazz Award recipient, and Professor of Music (Jazz Studies) at the Indiana University Jacobs School of Music.';
---
<Base title="About" description={description}>
  <section class="about-hero dark">
    <div class="photo photo--bw about-hero__photo" aria-hidden="true">
      <Image src={laugh} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
    <div class="container container--wide about-hero__inner">
      <T k="about.hero.label" as="p" class="label" style="color:var(--brass)" />
      <h1 class="about-hero__title"><T k="about.hero.firstName" /><T k="about.hero.lastName" /></h1>
      <T k="about.hero.lede" as="p" class="lede about-hero__lede" />
    </div>
  </section>

  <section class="section">
    <div class="container bio">
      <aside class="bio__side" data-reveal="left">
        <div class="photo bio__portrait">
          <Image src={profile} alt="Sean Dobbins in a blue suit, spinning a drumstick." widths={[500, 900, 1300]} sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
        <div class="bio__facts">
          <div class="fact"><T k="about.facts.nowLabel" class="label" /><T k="about.facts.now" /></div>
          <div class="fact"><T k="about.facts.fromLabel" class="label" /><T k="about.facts.from" /></div>
          <div class="fact"><T k="about.facts.awardsLabel" class="label" /><span>{c.awards.map((a, i) => <>{i > 0 && ' · '}<T k={`about.awards.${i}`} /></>)}</span></div>
          <div class="fact"><T k="about.facts.influencesLabel" class="label" /><span>{c.influences.map((a, i) => <>{i > 0 && ', '}<T k={`about.influences.${i}`} /></>)}</span></div>
          <div class="fact"><T k="about.facts.taughtLabel" class="label" /><T k="about.facts.taught" /></div>
        </div>
      </aside>
      <div class="bio__body prose" data-reveal>
        <p class="lede"><T k="about.bio.lede" as="strong" /></p>
        {c.bio.paragraphs.map((_, i) => (
          i === c.bio.paragraphs.length - 1
            ? <p><T k={`about.bio.paragraphs.${i}`} /> <a href="/barbershop" data-edit="about.bio.closingLink">{c.bio.closingLink}</a>.</p>
            : <T k={`about.bio.paragraphs.${i}`} as="p" />
        ))}
        <div class="bio__actions">
          <a href="/contact" class="btn btn--primary" data-edit="about.bio.book">{c.bio.book}</a>
          <a href="/outreach" class="link"><T k="about.bio.outreachLink" /> <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="played stage">
    <div class="container container--wide">
      <SectionHead numKey="about.played.num" titleKey="about.played.title" blurbKey="about.played.blurb" />
    </div>
    <Marquee items={c.playedWith} speed={70} keyPrefix="about.playedWith" />
    <div class="container container--wide">
      <ul role="list" class="names" aria-label="Full list">
        {c.playedWith.map((n, i) => { const p = photoFor(n); return p ? (
          <li class="names__item has-peek" data-reveal style={`--reveal-delay:${(i % 8) * 40}ms`}>
            {p.url
              ? <a class="names__btn" href={p.url} target="_blank" rel="noopener" aria-controls={`peek-${i}`} data-peek data-edit={`about.playedWith.${i}`}>{n}</a>
              : <button type="button" class="names__btn" aria-expanded="false" aria-controls={`peek-${i}`} data-peek data-edit={`about.playedWith.${i}`}>{n}</button>}
            <div class="peek paper" id={`peek-${i}`} role="group" aria-label={n}>
              <button type="button" class="peek__close" data-peek-close aria-label="Close">×</button>
              <div class="peek__photo">{p.img ? <Image src={p.img} alt={n} widths={[240, 480]} sizes="240px" loading="lazy" /> : <img src={p.src} alt={n} width="480" height="480" loading="lazy" />}</div>
              <div class="peek__meta">
                <strong class="peek__name">{n}</strong>
                {p.url && <a class="link peek__site" href={p.url} target="_blank" rel="noopener">Visit website ↗</a>}
                {(p.credit || p.license || p.source) && <span class="small muted">{[p.credit && `Photo: ${p.credit}`, p.license].filter(Boolean).join(' · ')}{p.source && <>{(p.credit || p.license) && ' · '}<a class="peek__src" href={p.source} target="_blank" rel="noopener">Wikimedia Commons</a></>}</span>}
              </div>
            </div>
          </li>
        ) : entryFor(n)?.url ? (
          <li class="names__item" data-reveal style={`--reveal-delay:${(i % 8) * 40}ms`}><a class="names__site" href={entryFor(n)!.url} target="_blank" rel="noopener" data-edit={`about.playedWith.${i}`}>{n}</a></li>
        ) : (
          <li class="names__item" data-reveal style={`--reveal-delay:${(i % 8) * 40}ms`} data-edit={`about.playedWith.${i}`}>{n}</li>
        ); })}
      </ul>
    </div>
  </section>

  <section class="section press">
    <div class="container container--wide">
      <SectionHead numKey="about.press.num" titleKey="about.press.title" blurbKey="about.press.blurb" />
      <ol role="list" class="press__rows">
        {c.press.items.map((p, i) => (
          <li class="press__row" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 50}ms`}>
            <span class="press__year" data-edit={`about.press.items.${i}.year`}>{p.year}</span>
            <div class="press__main">
              {p.url
                ? <a class="press__title" href={p.url} target="_blank" rel="noopener" data-edit={`about.press.items.${i}.title`}>{p.title}</a>
                : <span class="press__title" data-edit={`about.press.items.${i}.title`}>{p.title}</span>}
              <span class="small muted" data-edit={`about.press.items.${i}.outlet`}>{p.outlet}</span>
            </div>
            {p.url && <span class="press__arrow" aria-hidden="true">↗</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PhotoGallery />
</Base>

<script>
  // Computer (hover + mouse): hovering a name shows the photo card (CSS), clicking a linked name opens the site in a new tab.
  // Phone/tablet (touch): tapping a name opens the card with a close cross; the link under the photo opens the site.
  function bind() {
    const list = document.querySelector<HTMLElement>('.names:not([data-bound])');
    if (!list) return; list.dataset.bound = '1';
    const hoverDevice = () => matchMedia('(hover: hover) and (pointer: fine)').matches;
    const closeAll = () => list.querySelectorAll('.has-peek.is-open').forEach((li) => { li.classList.remove('is-open'); li.querySelector('[data-peek]')?.setAttribute('aria-expanded', 'false'); });
    list.querySelectorAll<HTMLElement>('[data-peek]').forEach((el) => el.addEventListener('click', (e) => {
      if (hoverDevice()) { if (el.tagName === 'BUTTON') e.preventDefault(); setTimeout(() => el.blur(), 0); return; } // hover shows the card; a link just follows; drop focus so the card doesn't linger
      e.preventDefault();
      const li = el.closest('li')!; const open = li.classList.contains('is-open'); closeAll();
      if (!open) { li.classList.add('is-open'); el.setAttribute('aria-expanded', 'true'); }
    }));
    list.querySelectorAll<HTMLElement>('[data-peek-close]').forEach((b) => b.addEventListener('click', closeAll));
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.has-peek')) closeAll(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .about-hero { position: relative; overflow: hidden; min-height: clamp(420px, 60vh, 680px); display: flex; align-items: flex-end; }
  .about-hero__photo { position: absolute; inset: 0; }
  .about-hero__photo img { object-position: 55% 30%; }
  .about-hero__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--ink) 8%, rgba(11,11,20,.35) 55%, rgba(11,11,20,.15)); }
  .about-hero__inner { position: relative; padding-block: var(--s-6) var(--s-6); display: flex; flex-direction: column; gap: var(--s-2); }
  .about-hero__title { display: flex; flex-direction: column; font-size: clamp(72px, 14vw, 190px); line-height: .82; }
  .about-hero__lede { color: var(--ivory-80); max-width: 40ch; }
  @media (prefers-reduced-motion: no-preference) {
    .about-hero__title span { animation: up .9s var(--ease-out) both; } .about-hero__title span:nth-child(2) { animation-delay: .12s; }
    .about-hero__lede, .about-hero .label { animation: up .8s var(--ease-out) .3s both; }
    .about-hero__photo img { animation: zoom 3s var(--ease-out) both; }
  }
  @keyframes up { from { opacity: 0; transform: translateY(.4em); } }
  @keyframes zoom { from { transform: scale(1.06); } }

  .bio { display: grid; gap: var(--s-6); }
  @media (min-width: 900px) { .bio { grid-template-columns: 34% 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; } .bio__side { position: sticky; top: 88px; } }
  .bio__portrait { aspect-ratio: 3 / 4; }
  .bio__facts { display: flex; flex-direction: column; margin-top: var(--s-3); }
  .fact { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 12px 0; border-top: var(--hairline); font-size: 14px; line-height: 1.4; }
  .fact:last-child { border-bottom: var(--hairline); }
  .bio__body .lede { font-size: clamp(19px, 1.8vw, 23px); }
  .bio__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-4); }

  .played { padding-block: clamp(48px, 8vw, 96px) var(--s-8); }
  .names { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px 24px; margin-top: var(--s-6); font-size: 14px; color: var(--ivory-80); }
  .names li { padding: 6px 0; border-top: var(--hairline-dark); position: relative; }
  .has-peek:hover, .has-peek:focus-within, .has-peek.is-open { z-index: 20; }

  .press__rows { margin-top: var(--s-5); }
  .press__row { display: grid; grid-template-columns: 72px 1fr auto; gap: var(--s-2); align-items: center; padding: 14px 0; border-top: var(--hairline); }
  .press__rows li:last-child { border-bottom: var(--hairline); }
  .press__year { font-family: var(--font-display); font-size: 28px; color: var(--royal); line-height: 1; }
  .press__main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .press__title { font-family: var(--font-voice); font-style: italic; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.25; color: var(--ink); }
  a.press__title { border-bottom: 1.5px solid var(--brass); width: max-content; max-width: 100%; }
  a.press__title:hover { border-bottom-width: 2px; color: var(--stage); }
  .press__arrow { color: var(--brass); }
  @media (max-width: 520px) { .press__row { grid-template-columns: 60px 1fr; } .press__arrow { display: none; } }
  .names__btn { all: unset; cursor: pointer; color: inherit; display: block; padding: 0; border-bottom: 1.5px dotted var(--brass); width: max-content; max-width: 100%; }
  a.names__btn { cursor: pointer; }
  button.names__btn { cursor: default; }
  .names__btn:hover, .names__btn:focus-visible, .has-peek.is-open .names__btn { color: var(--ivory); border-bottom-style: solid; }
  .names__btn:focus-visible { outline: 2px solid var(--royal); outline-offset: 3px; }
  .peek { display: none; z-index: 5; width: 240px; color: var(--ink); padding: 8px; box-shadow: 0 12px 32px rgba(11, 11, 20, .45); position: relative; }
  .peek__close { position: absolute; top: 12px; right: 12px; z-index: 1; width: 32px; height: 32px; border: 0; background: var(--paper); color: var(--ink); font-size: 22px; line-height: 1; cursor: pointer; display: none; }
  .peek__close:focus-visible { outline: 2px solid var(--royal); }
  .peek__photo { aspect-ratio: 1; background: var(--ink); overflow: hidden; }
  .peek__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .peek__meta { display: flex; flex-direction: column; gap: 2px; padding: 10px 4px 4px; }
  .peek__name { font-size: 15px; color: var(--ink); font-weight: 600; }
  .peek__site { width: max-content; margin-top: 4px; font-size: 14px; }
  .names__site { color: inherit; border-bottom: 1.5px dotted var(--brass); }
  .names__site:hover { color: var(--ivory); border-bottom-style: solid; }
  .peek .muted { color: var(--walnut); font-size: 12px; line-height: 1.4; }
  .peek__src { color: var(--walnut); text-decoration: underline; white-space: nowrap; }
  .has-peek.is-open .peek { display: block; }
  @media (hover: hover) and (pointer: fine) {
    .peek { position: absolute; left: 0; bottom: calc(100% + 6px); }
    .has-peek.is-open .peek { display: none; }
    .has-peek:hover .peek, .has-peek:focus-within .peek { display: block; }
    .names__item:nth-child(-n + 4) .peek { bottom: auto; top: calc(100% + 6px); }
  }
  @media (hover: none), (pointer: coarse) {
    .peek { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); width: min(320px, calc(100vw - 32px)); }
    .peek__close { display: block; }
    button.names__btn { cursor: pointer; }
  }

</style>
