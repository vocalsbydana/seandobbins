---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import T from '../components/T.astro';
import { copy } from '../lib/copy';
import bwStars from '../assets/photos/bw-stars.jpg';
import profile from '../assets/photos/profile-brushes.jpg';
import laugh from '../assets/photos/laugh-warm.jpg';
import kit from '../assets/photos/stage-kit.jpg';

const c = copy.about;
const description = 'Sean Dobbins, jazz drummer: Detroit sideman, bandleader, Woody Herman Jazz Award recipient, and Professor of Music (Jazz Studies) at the Indiana University Jacobs School of Music.';
---
<Base title="About" description={description}>
  <section class="about-hero dark">
    <div class="photo photo--bw about-hero__photo" aria-hidden="true">
      <Image src={bwStars} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
    <div class="container container--wide about-hero__inner">
      <T k="about.hero.label" as="p" class="label" style="color:var(--brass)" />
      <h1 class="about-hero__title"><T k="about.hero.firstName" /><T k="about.hero.lastName" /></h1>
      <T k="about.hero.lede" as="p" class="lede about-hero__lede" />
    </div>
  </section>

  <section class="section">
    <div class="container bio">
      <aside class="bio__side" data-reveal="left">
        <div class="photo bio__portrait">
          <Image src={profile} alt="Sean Dobbins with brushes, in profile." widths={[500, 900, 1300]} sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
        <div class="bio__facts">
          <div class="fact"><T k="about.facts.nowLabel" class="label" /><T k="about.facts.now" /></div>
          <div class="fact"><T k="about.facts.fromLabel" class="label" /><T k="about.facts.from" /></div>
          <div class="fact"><T k="about.facts.awardsLabel" class="label" /><span>{c.awards.map((a, i) => <>{i > 0 && ' · '}<T k={`about.awards.${i}`} /></>)}</span></div>
          <div class="fact"><T k="about.facts.influencesLabel" class="label" /><span>{c.influences.map((a, i) => <>{i > 0 && ', '}<T k={`about.influences.${i}`} /></>)}</span></div>
        </div>
      </aside>
      <div class="bio__body prose" data-reveal>
        <p class="lede"><T k="about.bio.lede" as="strong" /></p>
        {c.bio.paragraphs.map((_, i) => <T k={`about.bio.paragraphs.${i}`} as="p" />)}
        <T k="about.bio.educatorHeading" as="h3" />
        {c.bio.educatorParagraphs.map((_, i) => (
          i === c.bio.educatorParagraphs.length - 1
            ? <p><T k={`about.bio.educatorParagraphs.${i}`} /> <a href="/barbershop" data-edit="about.bio.closingLink">{c.bio.closingLink}</a>.</p>
            : <T k={`about.bio.educatorParagraphs.${i}`} as="p" />
        ))}
        <div class="bio__actions">
          <a href="/contact" class="btn btn--primary" data-edit="about.bio.book">{c.bio.book}</a>
          <a href="/outreach" class="link"><T k="about.bio.outreachLink" /> <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="played stage">
    <div class="container container--wide">
      <SectionHead numKey="about.played.num" titleKey="about.played.title" blurbKey="about.played.blurb" />
    </div>
    <Marquee items={c.playedWith} speed={70} keyPrefix="about.playedWith" />
    <div class="container container--wide">
      <ul role="list" class="names" aria-label="Full list">
        {c.playedWith.map((n, i) => <li data-reveal style={`--reveal-delay:${(i % 8) * 40}ms`} data-edit={`about.playedWith.${i}`}>{n}</li>)}
      </ul>
    </div>
  </section>

  <section class="section--tight strip">
    <div class="container container--wide strip__grid">
      <figure class="photo strip__a" data-reveal="scale">
        <Image src={laugh} alt="Sean laughing at the kit under warm light. Photo: Jeff Dunn Jazz Photography." widths={[600, 1000, 1400]} sizes="(min-width: 900px) 58vw, 100vw" />
        <T k="about.strip.captionA" as="figcaption" class="small muted" />
      </figure>
      <figure class="photo strip__b" data-reveal="scale" style="--reveal-delay:120ms">
        <Image src={kit} alt="Sean behind a Yamaha kit against blue curtains." widths={[500, 900, 1200]} sizes="(min-width: 900px) 40vw, 100vw" />
        <T k="about.strip.captionB" as="figcaption" class="small muted" />
      </figure>
    </div>
  </section>
</Base>

<style>
  .about-hero { position: relative; overflow: hidden; min-height: clamp(420px, 60vh, 680px); display: flex; align-items: flex-end; }
  .about-hero__photo { position: absolute; inset: 0; }
  .about-hero__photo img { object-position: 60% 25%; }
  .about-hero__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--ink) 8%, rgba(11,11,20,.35) 55%, rgba(11,11,20,.15)); }
  .about-hero__inner { position: relative; padding-block: var(--s-6) var(--s-6); display: flex; flex-direction: column; gap: var(--s-2); }
  .about-hero__title { display: flex; flex-direction: column; font-size: clamp(72px, 14vw, 190px); line-height: .82; }
  .about-hero__lede { color: var(--ivory-80); max-width: 40ch; }
  @media (prefers-reduced-motion: no-preference) {
    .about-hero__title span { animation: up .9s var(--ease-out) both; } .about-hero__title span:nth-child(2) { animation-delay: .12s; }
    .about-hero__lede, .about-hero .label { animation: up .8s var(--ease-out) .3s both; }
    .about-hero__photo img { animation: zoom 3s var(--ease-out) both; }
  }
  @keyframes up { from { opacity: 0; transform: translateY(.4em); } }
  @keyframes zoom { from { transform: scale(1.06); } }

  .bio { display: grid; gap: var(--s-6); }
  @media (min-width: 900px) { .bio { grid-template-columns: 34% 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; } .bio__side { position: sticky; top: 88px; } }
  .bio__portrait { aspect-ratio: 3 / 4; }
  .bio__facts { display: flex; flex-direction: column; margin-top: var(--s-3); }
  .fact { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 12px 0; border-top: var(--hairline); font-size: 14px; line-height: 1.4; }
  .fact:last-child { border-bottom: var(--hairline); }
  .bio__body .lede { font-size: clamp(19px, 1.8vw, 23px); }
  .bio__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-4); }

  .played { padding-block: clamp(48px, 8vw, 96px) var(--s-8); }
  .names { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px 24px; margin-top: var(--s-6); font-size: 14px; color: var(--ivory-80); }
  .names li { padding: 6px 0; border-top: var(--hairline-dark); }

  .strip__grid { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .strip__grid { grid-template-columns: 1.45fr 1fr; align-items: end; } }
  .strip figure { background: none; display: flex; flex-direction: column; }
  .strip figure :global(img) { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .strip__b :global(img) { aspect-ratio: 4 / 5; }
  .strip figcaption { margin-top: 8px; }
</style>
