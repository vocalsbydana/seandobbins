---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import SectionHead from '../components/SectionHead.astro';
import T from '../components/T.astro';
import { copy } from '../lib/copy';
import { Image } from 'astro:assets';
import laugh from '../assets/photos/laugh-warm.jpg';
const c = copy.music;
const description = 'Watch and listen: Sean Dobbins live, on record, and on the streaming service of your choice. Selected discography as leader and sideman.';
---
<Base title="Music" description={description}>
  <section class="section">
    <div class="container">
      <SectionHead numKey="music.page.num" titleKey="music.page.title" as="h1" blurbKey="music.page.blurb" />
      <div class="videos">
        <div class="videos__lead" data-reveal="scale">
          <YouTube id={c.featuredVideoId} title="Sean Dobbins, featured video" />
        </div>
        <div class="videos__rest">
          {c.videos.map((v, i) => (
            <div data-reveal style={`--reveal-delay:${(i + 1) * 90}ms`}>
              <YouTube id={v.id} title={v.title || `Sean Dobbins, video ${i + 2}`} poster="hq" />
              {v.title && <T k={`music.videos.${i}.title`} as="p" class="small muted vcap" />}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {c.shorts.length > 0 && (
    <section class="section--tight shorts">
      <div class="container">
        <div class="shorts__head" data-reveal>
          <T k="music.shortsSection.label" as="p" class="label" />
          <T k="music.shortsSection.title" as="h2" class="display-3" />
        </div>
        <div class="shorts__row">
          {c.shorts.map((v, i) => (
            <div class="shorts__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <YouTube id={v.id} title={v.title || `Short ${i + 1}`} vertical />
              {v.title && <T k={`music.shorts.${i}.title`} as="p" class="small muted vcap" />}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section--tight stage">
    <div class="container stream">
      <div class="stream__copy" data-reveal>
        <T k="music.stream.label" as="p" class="label" />
        <T k="music.stream.title" as="h2" class="display-2" />
      </div>
      <ul role="list" class="stream__links" data-reveal style="--reveal-delay:120ms">
        {c.streaming.map((s, i) => <li><a href={s.url || '#'} class:list={['stream__link', { 'stream__link--soon': !s.url }]} target={s.url ? '_blank' : undefined} rel="noopener"><T k={`music.streaming.${i}.label`} /> <span class="arrow" aria-hidden="true">↗</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container disc">
      <div class="disc__list">
        <SectionHead numKey="music.disc.num" titleKey="music.disc.title" blurbKey="music.disc.blurb" />
        <ol role="list">
          {c.discography.map((d, i) => (
            <li class="disc__row" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}>
              <T k={`music.discography.${i}.year`} class="disc__year" />
              <div class="disc__main">
                <div class="disc__title">{d.url ? <a href={d.url} target="_blank" rel="noopener"><T k={`music.discography.${i}.title`} /></a> : <T k={`music.discography.${i}.title`} />}</div>
                <div class="small muted"><T k={`music.discography.${i}.artist`} /> · <T k={`music.discography.${i}.label`} /></div>
              </div>
              <T k={`music.discography.${i}.role`} class="label" />
            </li>
          ))}
        </ol>
      </div>
      <figure class="photo disc__photo" data-reveal="scale">
        <Image src={laugh} alt="Sean laughing behind the cymbals. Photo: Jeff Dunn Jazz Photography." widths={[500, 900]} sizes="(min-width: 900px) 36vw, 100vw" />
      </figure>
    </div>
  </section>
</Base>
<style>
  .videos { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .videos { grid-template-columns: 2fr 1fr; } .videos__rest { display: flex; flex-direction: column; gap: var(--s-3); } }
  @media (max-width: 899px) { .videos__rest { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); } }
  .vcap { margin-top: 8px; }
  .shorts { padding-top: 0; }
  .shorts__head { display: flex; flex-direction: column; gap: 8px; padding-bottom: var(--s-2); border-bottom: var(--hairline); margin-bottom: var(--s-3); }
  .shorts__row { display: flex; gap: var(--s-2); overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; padding-bottom: 8px; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
  .shorts__row::-webkit-scrollbar { display: none; }
  .shorts__item { flex: 0 0 min(72vw, 300px); scroll-snap-align: start; }
  @media (min-width: 720px) { .shorts__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; gap: var(--s-3); } .shorts__item { flex: none; } }
  @media (min-width: 1100px) { .shorts__row { grid-template-columns: repeat(3, 300px); justify-content: center; } }
  .stream { display: grid; gap: var(--s-4); align-items: center; }
  @media (min-width: 800px) { .stream { grid-template-columns: 1fr 1fr; } }
  .stream__links { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--s-3); }
  .stream__link { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; border-bottom: var(--hairline-dark); font-family: var(--font-display); font-size: 30px; letter-spacing: .03em; text-transform: uppercase; color: var(--ivory); }
  .stream__link:hover { color: var(--brass); }
  .stream__link--soon { color: var(--ivory-55); pointer-events: none; }
  .stream__link .arrow { font-size: 18px; transition: transform var(--dur-fast); }
  .stream__link:hover .arrow { transform: translate(3px, -3px); }
  .disc { display: grid; gap: var(--s-5); }
  @media (min-width: 900px) { .disc { grid-template-columns: 1.6fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: start; } .disc__photo { position: sticky; top: 88px; } }
  .disc__row { display: grid; grid-template-columns: 64px 1fr auto; gap: var(--s-2); align-items: center; padding: 14px 0; border-top: var(--hairline); }
  .disc ol li:last-child { border-bottom: var(--hairline); }
  .disc__year { font-family: var(--font-display); font-size: 28px; color: var(--royal); line-height: 1; }
  .disc__title { font-weight: 600; }
  .disc__title a { color: var(--ink); border-bottom: 1.5px solid var(--brass); }
  .disc__photo { aspect-ratio: 4 / 5; }
</style>
