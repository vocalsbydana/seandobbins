# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Public URL of the site (used for sitemap, OG tags, canonical links)
SITE_URL=https://seandobbins.com

# Secret used to sign the barbershop_unlocked cookie and to hash PDF filenames.
# Any long random string. Changing it invalidates every visitor's unlock cookie.
DOWNLOAD_SECRET=change-me-to-a-long-random-string

# MailerLite (Integrations → Developer API → Generate token)
MAILERLITE_API_KEY=
# Group IDs (Subscribers → Groups → open a group, the ID is in the URL)
MAILERLITE_GROUP_DRUMMERS=
MAILERLITE_GROUP_PROSPECTIVE=

# Contact form delivery via Resend (free tier). Leave empty to disable the form.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sean@example.com
CONTACT_FROM_EMAIL=site@seandobbins.com

# Decap CMS GitHub OAuth app (Settings → Developer settings → OAuth Apps)
# Authorization callback URL must be: https://<site>/api/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
