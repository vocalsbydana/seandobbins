# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Public URL of the site (used for sitemap, OG tags, canonical links)
SITE_URL=https://seandobbins.com

# Secret used to sign the barbershop_unlocked cookie, hash PDF filenames, and derive the editor session.
# Any long random string. Changing it invalidates every visitor's unlock cookie and logs the editor out.
DOWNLOAD_SECRET=change-me-to-a-long-random-string

# ---- The in-site editor at /admin ----
# The one password Sean (and Dana) type to edit the site.
ADMIN_PASSWORD=
# Fine-grained GitHub token with "Contents: read and write" on this one repository. The editor commits with it.
GITHUB_TOKEN=
GITHUB_REPO=vocalsbydana/seandobbins
# Optional: force edits onto a fixed branch. Default: the branch this deployment was built from (VERCEL_GIT_COMMIT_REF), else main.
# CONTENT_BRANCH=main
# Local development only: edit the working tree instead of committing to GitHub (ignored in production builds).
# ADMIN_STORE=local

# MailerLite (Integrations → Developer API → Generate token)
MAILERLITE_API_KEY=
# Group IDs (Subscribers → Groups → open a group, the ID is in the URL)
MAILERLITE_GROUP_DRUMMERS=
MAILERLITE_GROUP_PROSPECTIVE=

# Contact form delivery via Resend (free tier). Leave empty to disable the form.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sean@example.com
CONTACT_FROM_EMAIL=site@seandobbins.com
